        "url": "https://tlpnkcroqenudzgiqzum.supabase.co/rest/v1/rpc/registrar_carga",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_fuente: 'kommo-facturas', p_filas: $('Pedidos').first().json.filas.length }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "LWRuov5D7s6ILPbQ",
          "name": "Supabase (tablero)"
        }
      }
    }

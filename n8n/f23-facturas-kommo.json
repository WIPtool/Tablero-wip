              "value": "500"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleOAuth2Api": {
          "id": "jnLeMVYFho7CTP6Q",
          "name": "Google account"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "c2",
      "name": "Un ítem por correo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "jsCode": "return $input.all().flatMap((i) => (i.json.messages || []).map((m) => ({ json: { id: m.id } })));"
      }
    },
    {
      "id": "c3",
      "name": "Leer asunto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "url": "=https://gmail.googleapis.com/gmail/v1/users/me/messages/{{ $json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "format",
              "value": "metadata"
            },
            {
              "name": "metadataHeaders",
              "value": "Subject"
            }
          ]
        },
        "options": {
          "batching": {
            "batch": {
              "batchSize": 3,
              "batchInterval": 2000
            }
          }
        }
      },
      "credentials": {
        "googleOAuth2Api": {
          "id": "jnLeMVYFho7CTP6Q",
          "name": "Google account"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "c4",
      "name": "Pedidos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        100
      ],
      "parameters": {
        "jsCode": "const filas = [];\nfor (const it of $input.all()) {\n  const m = it.json;\n  const asunto = ((m.payload && m.payload.headers) || []).find((h) => h.name.toLowerCase() === 'subject');\n  const n = ((asunto && asunto.value) || '').match(/pedido\\s+#?(\\d+)/i);\n  if (!n) continue;\n  filas.push({\n    id: 'kommo:' + n[1], proveedor: 'kommo', cuenta: 'wiptool.kommo.com', numero: n[1],\n    fecha: new Date(Number(m.internalDate) - 5 * 3600e3).toISOString().slice(0, 10), // hora de Colombia\n    moneda: 'USD', estado: 'PAID', periodo: '', archivo: '',\n    correo_url: 'https://mail.google.com/mail/u/?authuser=misha@wiptool.com#all/' + m.id,\n  });\n}\nreturn [{ json: { filas } }];"
      }
    },
    {
      "id": "c5",
      "name": "Guardar pedidos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        100
      ],
      "parameters": {
        "url": "https://tlpnkcroqenudzgiqzum.supabase.co/rest/v1/proveedor_factura?on_conflict=id",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.filas) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "LWRuov5D7s6ILPbQ",
          "name": "Supabase (tablero)"
        }
      }
    },

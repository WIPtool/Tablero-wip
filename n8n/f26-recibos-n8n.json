{
  "name": "F26 · Recibos de n8n Cloud (Gmail → Supabase)",
  "nodes": [
    {
      "id": "a1",
      "name": "Cada día 7:10",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [

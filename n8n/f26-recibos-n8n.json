        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_fuente: 'n8n-facturas', p_filas: $('Recibos').first().json.filas.length }) }}",
        "options": {}

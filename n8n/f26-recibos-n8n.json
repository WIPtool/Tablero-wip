            }
          ]
        }
      }
    },
    {
      "id": "a2",
      "name": "Cargar histórico (a mano)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "b1",
      "name": "Últimos 60 días",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "return [{ json: { q: \"from:paddle.com (\\\"Cloud Starter\\\" OR \\\"n8n\\\") (recibo OR receipt) newer_than:60d\" } }];"
      }
    },
    {
      "id": "b2",
      "name": "Todo el histórico",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ],
      "parameters": {
        "jsCode": "return [{ json: { q: \"from:paddle.com (\\\"Cloud Starter\\\" OR \\\"n8n\\\") (recibo OR receipt)\" } }];"
      }
    },
    {
      "id": "c1",
      "name": "Buscar correos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.q }}"
            },
            {
              "name": "maxResults",
              "value": "500"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleOAuth2Api": {
          "id": "jnLeMVYFho7CTP6Q",
          "name": "Google account"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "c2",
      "name": "Un ítem por correo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "jsCode": "return $input.all().flatMap((i) => (i.json.messages || []).map((m) => ({ json: { id: m.id } })));"
      }
    },
    {
      "id": "c3",
      "name": "Leer correo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "url": "=https://gmail.googleapis.com/gmail/v1/users/me/messages/{{ $json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "format",
              "value": "metadata"
            },
            {
              "name": "metadataHeaders",
              "value": "Subject"
            }
          ]
        },
        "options": {
          "batching": {
            "batch": {
              "batchSize": 3,
              "batchInterval": 2000
            }
          }
        }
      },
      "credentials": {
        "googleOAuth2Api": {
          "id": "jnLeMVYFho7CTP6Q",
          "name": "Google account"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "c4",
      "name": "Recibos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        100
      ],
      "parameters": {
        "jsCode": "const aNumero = (s) => {\n  s = String(s).replace(/[^\\d.,]/g, '');\n  const i = Math.max(s.lastIndexOf('.'), s.lastIndexOf(','));\n  if (i >= 0 && s.length - i - 1 === 2) return Number(s.slice(0, i).replace(/[.,]/g, '') + '.' + s.slice(i + 1));\n  return Number(s.replace(/[.,]/g, ''));\n};\nconst filas = [];\nfor (const it of $input.all()) {\n  const m = it.json;\n  const t = String(m.snippet || '').replace(/&nbsp;| /g, ' ');\n  const n = (t.match(/(?:Recibo|Receipt)\\s*(?:n\\.?\\s*º|#|no\\.?)?\\s*([\\d]+-[\\d]+)/i) || [])[1];\n  if (!n) continue;\n  const p = t.match(/(?:Cantidad pagada|Amount paid)\\s*:?\\s*(?:(€|US\\$|\\$|USD|EUR)\\s?)?([\\d.,]+)\\s*(€|US\\$|\\$|USD|EUR)?/i);\n  const simbolo = p ? (p[1] || p[3] || '') : '';\n  filas.push({\n    id: 'n8n:' + n, proveedor: 'n8n', cuenta: 'n8n Cloud Starter', numero: n,\n    fecha: new Date(Number(m.internalDate) - 5 * 3600e3).toISOString().slice(0, 10), // hora de Colombia\n    monto: p ? aNumero(p[2]) : null, moneda: /€|EUR/i.test(simbolo) ? 'EUR' : 'USD', estado: 'PAID', periodo: '', archivo: '',\n    correo_url: 'https://mail.google.com/mail/u/?authuser=misha@wiptool.com#all/' + m.id,\n  });\n}\nreturn filas.length ? [{ json: { filas } }] : [];"
      }
    },
    {
      "id": "c5",
      "name": "Guardar recibos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        100
      ],
      "parameters": {
        "url": "https://tlpnkcroqenudzgiqzum.supabase.co/rest/v1/proveedor_factura?on_conflict=id",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.filas) }}",
        "options": {}
      },
      "credentials": {

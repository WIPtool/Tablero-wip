    {
      "id": "e5f0c0de-0002-4000-8000-000000000002",
      "name": "Evento de Brevo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const LISTAS = { 9: 'Info solicitada', 21: 'Nutrición' };\nconst b = $input.first().json.body || {};\nconst evento = String(b.event || '').toLowerCase();\nconst correo = String(b.email || '').trim().toLowerCase();\nconst listas = [].concat(b.list_id ?? b.listId ?? b.list_ids ?? []).map(Number);\nlet estado = null;\nif (/unsub|desuscr/.test(evento)) estado = 'Desuscrito';\nelse if (/list/.test(evento)) estado = LISTAS[listas.find((l) => LISTAS[l])] || null;\nif (!correo || !estado) return [];\nreturn [{ json: { correo, estado, evento, url: `https://wiptool.kommo.com/api/v4/contacts?query=${encodeURIComponent(correo)}&with=leads&limit=10` } }];\n"
      }
    },
    {
      "id": "e5f0c0de-0003-4000-8000-000000000003",
      "name": "Contacto en Kommo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 300
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "wxfP9VZK9UBkShIS",
          "name": "Kommo (lectura)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "e5f0c0de-0004-4000-8000-000000000004",
      "name": "Armar cambios en Kommo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const CAMPO_SECUENCIA = 537462;\nconst ENUMS = { 'Info solicitada': 439040, 'Nutrición': 439042, Desuscrito: 439044 };\nconst ENUM_OPT_DESUSCRITO = 361370; // contacto: \"Suscripción de marketing\" = Desuscrito\nconst ev = $('Evento de Brevo').first().json;\n// Kommo responde application/hal+json (llega como texto en data) y sin cuerpo (204) si no encuentra nada.\nconst r = $input.first().json;\nconst datos = typeof r.data === 'string' ? (() => { try { return JSON.parse(r.data); } catch (e) { return {}; } })() : r;\nconst contactos = ((datos._embedded && datos._embedded.contacts) || []).filter((c) => (c.custom_fields_values || [])\n  .some((f) => f.field_code === 'EMAIL' && (f.values || []).some((v) => String(v.value).trim().toLowerCase() === ev.correo)));\nconst leads = contactos.flatMap((c) => ((c._embedded && c._embedded.leads) || []).map((l) => Number(l.id)));\nif (!leads.length) return [];\nconst lead_id = Math.max(...leads);\nconst contacto = contactos.find((c) => ((c._embedded && c._embedded.leads) || []).some((l) => Number(l.id) === lead_id));\nreturn [{ json: {\n  lead: [{ id: lead_id, custom_fields_values: [{ field_id: CAMPO_SECUENCIA, values: [{ enum_id: ENUMS[ev.estado] }] }] }],\n  contacto: ev.estado === 'Desuscrito' ? [{ id: contacto.id, custom_fields_values: [{ field_code: 'opt_status', values: [{ enum_id: ENUM_OPT_DESUSCRITO }] }] }] : [],\n  nota: [{ entity_id: lead_id, note_type: 'common', params: { text: ev.estado === 'Desuscrito'\n    ? `${ev.correo} se dio de baja de los correos de WIP en Brevo. Secuencia Brevo: Desuscrito.`\n    : `${ev.correo} entró a la secuencia \"${ev.estado}\" de Brevo.` } }],\n} }];\n"
      }
    },

            }
          ]
        }
      }
    },
    {
      "id": "f7f0c0de-0002-4000-8000-000000000002",
      "name": "Demos de Calendly",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://www.googleapis.com/calendar/v3/calendars/primary/events?singleEvents=true&maxResults=100&q=calendly&timeMin={{ encodeURIComponent(new Date(Date.now() - 3600000).toISOString()) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 300
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api"
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "HYzI5UK7XVd09BpJ",
          "name": "Google Calendar (comercial@)"
        }
      }
    },
    {
      "id": "f7f0c0de-0003-4000-8000-000000000003",
      "name": "Demos por ajustar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const ASUNTO = 'Acercamiento Wip - Software para gestión de tus servicios';\nconst INVITADA = 'jessica@wiptool.com';\nconst salida = [];\nfor (const ev of ($input.first().json.items || [])) {\n  if (ev.status === 'cancelled' || !/calendly\\.com/i.test(ev.description || '')) continue;\n  const invitados = ev.attendees || [];\n  const falta = !invitados.some((p) => String(p.email || '').toLowerCase() === INVITADA);\n  if (ev.summary === ASUNTO && !falta) continue;\n  salida.push({ json: { id: ev.id, antes: ev.summary,\n    cuerpo: { summary: ASUNTO, ...(falta ? { attendees: [...invitados, { email: INVITADA }] } : {}) } } });\n}\nreturn salida;\n"
      }
    },
    {
      "id": "f7f0c0de-0004-4000-8000-000000000004",
      "name": "Asunto e invitada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "PATCH",
        "url": "=https://www.googleapis.com/calendar/v3/calendars/primary/events/{{ $json.id }}?sendUpdates=none",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 300
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.cuerpo) }}"
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "HYzI5UK7XVd09BpJ",
          "name": "Google Calendar (comercial@)"
        }
      },
      "onError": "continueRegularOutput"
    }
  ],

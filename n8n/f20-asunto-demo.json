{
  "name": "F20 · Asunto e invitación de las demos de Calendly (Google Calendar de comercial@)",
  "nodes": [
    {
      "id": "f7f0c0de-0001-4000-8000-000000000001",
      "name": "Cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,

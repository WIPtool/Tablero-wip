      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const d = new Date(Date.now() - 60 * 86400e3).toISOString().slice(0, 10);\nreturn [{ json: { url: \"https://graph.facebook.com/v23.0/act_1212455492189816/activities?fields=event_type,event_time,extra_data&limit=500\" + '&since=' + d } }];"
      }
    },
    {
      "id": "b2",
      "name": "Todo el histórico",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ],
      "parameters": {
        "jsCode": "const d = new Date(Date.now() - 3650 * 86400e3).toISOString().slice(0, 10);\nreturn [{ json: { url: \"https://graph.facebook.com/v23.0/act_1212455492189816/activities?fields=event_type,event_time,extra_data&limit=500\" + '&since=' + d } }];"
      }
    },
    {
      "id": "c1",
      "name": "Actividad de la cuenta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "pagination": {
            "pagination": {
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ $response.body.paging && $response.body.paging.next }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.paging || !$response.body.paging.next }}",
              "limitPagesFetched": true,
              "maxRequests": 60
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "mGflv9K19Myes2Fm",
          "name": "Meta Ads (lectura)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "c2",
      "name": "Cobros",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "jsCode": "const filas = [];\nfor (const it of $input.all()) {\n  for (const a of (it.json.data || [])) {\n    if (a.event_type !== 'ad_account_billing_charge') continue;\n    let x = {};\n    try { x = JSON.parse(a.extra_data || '{}'); } catch (e) { continue; }\n    if (!x.transaction_id) continue;\n    filas.push({\n      id: 'meta:' + x.transaction_id, proveedor: 'meta', cuenta: 'Wip · act_1212455492189816', numero: x.transaction_id,\n      fecha: new Date(new Date(a.event_time).getTime() - 5 * 3600e3).toISOString().slice(0, 10), // hora de Colombia\n      monto: Number(x.new_value), moneda: (x.currency || 'COP').toUpperCase(), estado: 'PAID', periodo: '', archivo: '', correo_url: '',\n    });\n  }\n}\nreturn [{ json: { filas } }];"
      }
    },
    {
      "id": "c3",
      "name": "Guardar cobros",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "url": "https://tlpnkcroqenudzgiqzum.supabase.co/rest/v1/proveedor_factura?on_conflict=id",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            }
          ]

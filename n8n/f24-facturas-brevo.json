      "id": "d2",
      "name": "PDF a archivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        100
      ],
      "parameters": {
        "jsCode": "const f = $('Adjuntos PDF').item.json;\nconst b64 = String($json.data || '').replace(/-/g, '+').replace(/_/g, '/');\nreturn { json: f, binary: { pdf: { data: b64, mimeType: 'application/pdf', fileName: f.nombre, fileExtension: 'pdf' } } };",
        "mode": "runOnceForEachItem"
      }
    },
